# Google Sheets API — Service Account
# Generar en GCP Console: IAM & Admin > Service Accounts > Keys > Add Key (JSON)
# Copiar el campo "client_email" del JSON:
GOOGLE_SHEETS_CLIENT_EMAIL=tu-service-account@proyecto.iam.gserviceaccount.com

# Copiar el campo "private_key" del JSON tal cual viene (incluyendo \n escapados).
# IMPORTANTE: el valor va entre comillas dobles. NO commitear este archivo con la key real.
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# ID del spreadsheet "Administración TUNQUELEN" (sacalo de la URL de Sheets)
GOOGLE_SPREADSHEET_ID=

# Nombres de las hojas (cambiar solo si renombraste alguna)
SHEET_FACTURAS=Facturas
SHEET_REMITOS=Remitos
SHEET_LIQUIDACIONES=Liquidacion de Granos
SHEET_LABORES=Orden de trabajo
